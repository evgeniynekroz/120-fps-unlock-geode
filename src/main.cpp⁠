#include <Geode/Geode.hpp>
#include <Geode/modify/MenuLayer.hpp>

using namespace geode::prelude;

class $modify(MyMenuLayer, MenuLayer) {
    bool init() {
        if (!MenuLayer::init()) {
            return false;
        }

        // Задаём интервал рендера Cocos2d-x: 1/120 секунды
        CCDirector::sharedDirector()->setAnimationInterval(1.0 / 120.0);
        log::info("[120FPS] Animation interval set to 120 FPS on MenuLayer init");

        return true;
    }
};

$execute {
    // Применяем принудительно на старте загрузки библиотек
    CCDirector::sharedDirector()->setAnimationInterval(1.0 / 120.0);
    log::info("[120FPS] Applied via $execute");
}
